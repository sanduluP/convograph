    {
      "id": "note-episode",
      "type": "text",
      "x": 402,
      "y": 876,
      "width": 292,
      "height": 86.25,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
