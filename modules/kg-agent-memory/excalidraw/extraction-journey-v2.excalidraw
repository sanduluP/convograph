      "isDeleted": false,
      "boundElements": [],
      "updated": 1786634406417,
      "link": null,
      "locked": false,
      "text": "an EPISODE is the unit that remembers WHERE a\nfact came from — it points back at those 5\nmessages.\n\nThat back-pointer is what lets retrieval return\nmessage indices later, instead of just facts.",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "an EPISODE is the unit that remembers WHERE a\nfact came from — it points back at those 5\nmessages.\n\nThat back-pointer is what lets retrieval return\nmessage indices later, instead of just facts.",
      "lineHeight": 1.25,
      "autoResize": true
    },
