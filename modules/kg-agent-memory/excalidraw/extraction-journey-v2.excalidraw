      "link": null,
      "locked": false,
      "text": "•  entity seen in an earlier window?  reuse\n   that node\n•  does a new fact CONTRADICT an older one?\n       →  the older one gets  invalid_at = now\n\nthe contradiction prompt is the ONE piece we\nrewrote",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "•  entity seen in an earlier window?  reuse\n   that node\n•  does a new fact CONTRADICT an older one?\n       →  the older one gets  invalid_at = now\n\nthe contradiction prompt is the ONE piece we\nrewrote",
      "lineHeight": 1.25,
      "autoResize": true
