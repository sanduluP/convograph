      "roundness": null,
      "seed": 3019,
      "version": 4,
      "versionNonce": 1054164642,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787930094790,
      "link": null,
      "locked": false,
      "text": "THE ONE THING BM25 CANNOT DO. invalid_at IS\nNULL  →  ranked above superseded facts, so\n\"what is the CURRENT X?\" gets the latest\ndecision while the old one stays retrievable\nfor history questions.",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE ONE THING BM25 CANNOT DO. invalid_at IS\nNULL  →  ranked above superseded facts, so\n\"what is the CURRENT X?\" gets the latest\ndecision while the old one stays retrievable\nfor history questions.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bmW"
