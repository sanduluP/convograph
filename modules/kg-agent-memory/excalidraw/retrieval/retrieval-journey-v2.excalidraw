      "versionNonce": 398709758,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787930094790,
      "link": null,
      "locked": false,
      "text": "this is why EPISODES matter: they are the back-\npointer. We ingested COARSELY (5 messages at a\ntime) but must return PRECISE message numbers,\nso we re-rank inside the window with a cheap\nword overlap against the query.",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this is why EPISODES matter: they are the back-\npointer. We ingested COARSELY (5 messages at a\ntime) but must return PRECISE message numbers,\nso we re-rank inside the window with a cheap\nword overlap against the query.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bmT"
    },
