      "isDeleted": false,
      "boundElements": [],
      "updated": 1787930094790,
      "link": null,
      "locked": false,
      "text": "the judge NEVER sees the passages — only\nquestion + gold answer + agent answer.\n\nSo it grades the ANSWER, not the retrieval. A\nlenient judge lifts every system's score at\nonce.",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "the judge NEVER sees the passages — only\nquestion + gold answer + agent answer.\n\nSo it grades the ANSWER, not the retrieval. A\nlenient judge lifts every system's score at\nonce.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bme"
