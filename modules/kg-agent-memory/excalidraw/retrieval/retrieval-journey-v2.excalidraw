      "updated": 1787930097286,
      "link": null,
      "locked": false,
      "text": "SEARCH the facts, two ways at once\nkeyword (BM25)  +  meaning\n(embedding)\nthen fuse the two rankings (RRF)",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a2",
      "originalText": "SEARCH the facts, two ways at once\nkeyword (BM25)  +  meaning (embedding)\nthen fuse the two rankings (RRF)",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bmG"
    },
    {
      "id": "note-a2",
      "type": "text",
      "x": 1090,
      "y": 288,
      "width": 292,
      "height": 100.625,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3013,
      "version": 4,
      "versionNonce": 296897150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787930094790,
      "link": null,
      "locked": false,
      "text": "BOTH searches read the same thing: the fact\nSENTENCE. Entity names are never matched. The\nrelation name (REQUIRES, OWNS …) is never read.\nThe graph is NOT walked.\n\n→ so this is BM25 over extracted sentences,\n   plus an embedding.",
      "fontSize": 11.5,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BOTH searches read the same thing: the fact\nSENTENCE. Entity names are never matched. The\nrelation name (REQUIRES, OWNS …) is never read.\nThe graph is NOT walked.\n\n→ so this is BM25 over extracted sentences,\n   plus an embedding.",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "bmH"
    },
