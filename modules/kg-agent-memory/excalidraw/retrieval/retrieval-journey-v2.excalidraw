      "autoResize": true,
      "index": "bmV"
    },
    {
      "id": "note-a3",
      "type": "text",
      "x": 1090,
      "y": 582,
      "width": 292,
      "height": 71.875,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
