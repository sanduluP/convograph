      "text": "ONE EPISODE, now in Neo4j\n= the window + its entities + its facts",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "d5",
      "originalText": "ONE EPISODE, now in Neo4j\n= the window + its entities + its facts",
      "lineHeight": 1.25,
      "index": "aP",
      "autoResize": true
    },
    {
      "id": "note-episode",
      "type": "text",
      "x": 700,
      "y": 1045,
      "width": 540,
      "height": 80,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1027,
      "version": 2,
      "versionNonce": 1250206668,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786634406417,
      "link": null,
      "locked": false,
      "text": "an EPISODE is the unit that remembers WHERE a fact\ncame from — it points back at those 5 messages.\n\nThat back-pointer is what lets retrieval return\nmessage indices later, instead of just facts.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "an EPISODE is the unit that remembers WHERE a fact\ncame from — it points back at those 5 messages.\n\nThat back-pointer is what lets retrieval return\nmessage indices later, instead of just facts.",
      "lineHeight": 1.25,
      "index": "aQ",
      "autoResize": true
    },
