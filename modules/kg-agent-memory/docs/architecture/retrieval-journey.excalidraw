      "boundElements": [],
      "updated": 1786635089216,
      "link": null,
      "locked": false,
      "text": "THE ONE THING BM25 CANNOT DO.\ninvalid_at IS NULL  →  ranked above superseded facts,\nso \"what is the CURRENT X?\" gets the latest decision\nwhile the old one stays retrievable for history questions.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "THE ONE THING BM25 CANNOT DO.\ninvalid_at IS NULL  →  ranked above superseded facts,\nso \"what is the CURRENT X?\" gets the latest decision\nwhile the old one stays retrievable for history questions.",
      "lineHeight": 1.25,
