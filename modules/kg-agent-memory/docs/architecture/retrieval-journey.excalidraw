      "updated": 1786635089216,
      "link": null,
      "locked": false,
      "text": "SEARCH the facts, two ways at once\nkeyword (BM25)  +  meaning (embedding)\nthen fuse the two rankings (RRF)",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a2",
      "originalText": "SEARCH the facts, two ways at once\nkeyword (BM25)  +  meaning (embedding)\nthen fuse the two rankings (RRF)",
      "lineHeight": 1.25,
      "index": "aB",
      "autoResize": true
    },
    {
      "id": "note-a2",
      "type": "text",
      "x": 700,
      "y": 360,
      "width": 580,
      "height": 100,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3013,
      "version": 2,
      "versionNonce": 941020289,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786635089216,
      "link": null,
      "locked": false,
      "text": "BOTH searches read the same thing: the fact SENTENCE.\nEntity names are never matched. The relation name\n(REQUIRES, OWNS …) is never read. The graph is NOT walked.\n\n→ so this is BM25 over extracted sentences, plus an embedding.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "BOTH searches read the same thing: the fact SENTENCE.\nEntity names are never matched. The relation name\n(REQUIRES, OWNS …) is never read. The graph is NOT walked.\n\n→ so this is BM25 over extracted sentences, plus an embedding.",
      "lineHeight": 1.25,
      "index": "aC",
      "autoResize": true
    },
