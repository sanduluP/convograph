      "index": "aY",
      "autoResize": true
    },
    {
      "id": "note-a6",
      "type": "text",
      "x": 700,
      "y": 1265,
      "width": 580,
      "height": 80,
      "angle": 0,
      "strokeColor": "#868e96",
