      "text": "WALK BACK TO THE SOURCE\nfact → its episode → those 5 messages\n→ keep the single best-matching one",
      "fontSize": 15,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "a4",
      "originalText": "WALK BACK TO THE SOURCE\nfact → its episode → those 5 messages\n→ keep the single best-matching one",
      "lineHeight": 1.25,
      "index": "aK",
      "autoResize": true
    },
    {
      "id": "note-a4",
      "type": "text",
      "x": 700,
      "y": 685,
      "width": 580,
      "height": 80,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3022,
      "version": 2,
      "versionNonce": 1891332239,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786635089216,
      "link": null,
      "locked": false,
      "text": "this is why EPISODES matter: they are the back-pointer.\nWe ingested COARSELY (5 messages at a time) but must\nreturn PRECISE message numbers, so we re-rank inside\nthe window with a cheap word overlap against the query.",
      "fontSize": 14,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "this is why EPISODES matter: they are the back-pointer.\nWe ingested COARSELY (5 messages at a time) but must\nreturn PRECISE message numbers, so we re-rank inside\nthe window with a cheap word overlap against the query.",
      "lineHeight": 1.25,
      "index": "aL",
      "autoResize": true
    },
