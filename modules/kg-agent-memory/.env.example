# Copy this file to `.env` and fill in your credentials.
# `.env` is git-ignored and the eval scripts auto-load it via load_env_file().

# ─── LLM provider ────────────────────────────────────────────────────────────
# Set to "azure_openai" (default) or "openai".
LLM_PROVIDER=azure_openai

# ─── Azure OpenAI (chat + embedding) ────────────────────────────────────────
# Used for the gpt-5 QA agent / judge AND for text-embedding-3-large by default.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Optional: override the embedding endpoint/key independently of chat.
# EMBEDDING_AZURE_ENDPOINT=
# EMBEDDING_AZURE_OPENAI_API_KEY=
# EMBEDDING_AZURE_API_VERSION=2024-02-15-preview

# ─── OpenAI (alternative) ────────────────────────────────────────────────────
# Only needed if LLM_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# EMBEDDING_PROVIDER=openai
# EMBEDDING_OPENAI_API_KEY=
