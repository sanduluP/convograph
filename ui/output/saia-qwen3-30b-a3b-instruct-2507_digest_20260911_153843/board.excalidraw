      "x": 2038.04,
      "y": 352.0,
      "width": 300,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
