      ],
      "frameId": null,
      "roundness": null,
      "seed": 954916978,
      "versionNonce": 663644613,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133964677,
      "link": null,
      "locked": false,
      "text": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
      "originalText": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
