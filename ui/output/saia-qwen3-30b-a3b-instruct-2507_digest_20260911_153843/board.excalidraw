      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133964677,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires the owner chain.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires the owner chain.",
