    },
    {
      "type": "text",
      "id": "79e008d933924fb1",
      "x": 2038.04,
      "y": 280.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "be3d171217e84007"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1036842500,
      "versionNonce": 274488779,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133964677,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires confirmation of any blocked approvals.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires confirmation of any blocked approvals.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
