      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133964677,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires a rollback trigger.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires a rollback trigger.",
