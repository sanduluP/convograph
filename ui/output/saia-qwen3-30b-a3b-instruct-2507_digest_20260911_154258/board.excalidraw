      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789134225823,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires a handoff path.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires a handoff path.",
