      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789134225823,
      "link": null,
      "locked": false,
      "text": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
      "originalText": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
