      "roundness": null,
      "seed": 839619170,
      "versionNonce": 2094339003,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires the owner chain.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires the owner chain.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "type": "text",
      "id": "6a09db37b4af4dd3",
      "x": 1983.48,
      "y": 244.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aeb0782c63bb4d7d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1766043598,
      "versionNonce": 799252308,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires a handoff path.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires a handoff path.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "type": "text",
      "id": "049f9777820c48df",
      "x": 1983.48,
      "y": 280.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aeb0782c63bb4d7d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1301791235,
      "versionNonce": 778698964,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires confirmation of any blocked approvals.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires confirmation of any blocked approvals.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "type": "text",
      "id": "9b7f5beea2ab463a",
      "x": 1983.48,
      "y": 316.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aeb0782c63bb4d7d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 2147314286,
      "versionNonce": 1647767603,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
      "originalText": "\u2022 The production readiness spec requires access\nreview sign-off from Ops, Security, and Support.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "type": "text",
      "id": "3c88c33497bf436f",
      "x": 1983.48,
      "y": 352.0,
      "width": 300,
      "height": 45.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aeb0782c63bb4d7d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 811878861,
      "versionNonce": 605165772,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The readiness spec should require a\ntimestamped fallback path to prevent soft\nsign-off.",
      "originalText": "\u2022 The readiness spec should require a\ntimestamped fallback path to prevent soft\nsign-off.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
    {
      "type": "text",
      "id": "d1159123a5374e9e",
      "x": 1983.48,
      "y": 403.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "aeb0782c63bb4d7d"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 151214807,
      "versionNonce": 731667702,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires a rollback trigger.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires a rollback trigger.",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 10
    },
