      "isDeleted": false,
      "boundElements": null,
      "updated": 1789133895626,
      "link": null,
      "locked": false,
      "text": "\u2022 The production deployment readiness spec\nrequires final reporting validation.",
      "originalText": "\u2022 The production deployment readiness spec\nrequires final reporting validation.",
