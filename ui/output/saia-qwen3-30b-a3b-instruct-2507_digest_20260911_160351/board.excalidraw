      "id": "aad5f3075bbe4d04",
      "x": 1928.94,
      "y": 316.0,
      "width": 300,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#5c5f66",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
